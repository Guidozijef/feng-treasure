/* pages/profile/profile.wxss */
.profile-page {
  background-color: #f8fafc;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 1. 自定义顶部导航栏 (适配状态栏并与微信原生胶囊水平对齐) */
.custom-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  z-index: 1000;
  box-shadow: 0 1rpx 0 rgba(0, 0, 0, 0.05);
}

.nav-content {
  display: flex;
  align-items: center;
  padding-left: 28rpx;
  box-sizing: border-box;
}

.nav-title-box {
  display: flex;
  align-items: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -0.5rpx;
}

.nav-badge-pro {
  font-size: 22rpx;
  font-weight: 800;
  color: #0f5bd8;
  background: #e0ecff;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 页面内容区 */
.profile-body {
  padding: 20rpx 28rpx;
  padding-bottom: 60rpx;
}

/* 2. 用户身份特权卡片 */
.user-id-card {
  background: #ffffff;
  border-radius: 28rpx;
  border: 1rpx solid #eef2f6;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.025);
}

.user-top-row {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  position: relative;
  width: 108rpx;
  height: 108rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.avatar-img {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  border: 2rpx solid #e2e8f0;
  box-sizing: border-box;
}

.avatar-verified-badge {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 26rpx;
  height: 26rpx;
  background: #0f5bd8;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
}

.user-meta-wrap {
  flex: 1;
  min-width: 0;
}

.name-svip-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.user-nickname {
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 280rpx;
}

.svip-badge {
  background-color: #F59E0B;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  margin-left: 14rpx;
  box-shadow: 0 2rpx 8rpx rgba(234, 88, 12, 0.2);
  white-space: nowrap;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}

.svip-flash-icon {
  width: 25rpx;
  height: 25rpx;
  display: block;
  flex-shrink: 0;
}

.svip-text {
  font-size: 22rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 0.5rpx;
  line-height: 1;
}

.normal-user-tag {
  background-color: #f1f5f9;
  border: 1rpx solid #e2e8f0;
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
  margin-left: 14rpx;
  white-space: nowrap;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
}

.normal-tag-text {
  font-size: 20rpx;
  font-weight: 600;
  color: #64748b;
  line-height: 1;
}

.uid-row {
  display: inline-flex;
}

.uid-capsule {
  display: inline-flex;
  align-items: center;
  background: #f1f5f9;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  gap: 8rpx;
}

.uid-label {
  font-size: 22rpx;
  color: #64748b;
  font-family: monospace;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
}

.copy-icon {
  width: 22rpx;
  height: 22rpx;
  opacity: 0.7;
  flex-shrink: 0;
  display: block;
}

.settings-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.settings-icon {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.user-bottom-row {
  border-top: 1rpx solid #f1f5f9;
  margin-top: 24rpx;
  padding-top: 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.privilege-status-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.green-status-dot {
  width: 12rpx;
  height: 12rpx;
  background: #10b981;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.gray-status-dot {
  width: 12rpx;
  height: 12rpx;
  background: #94a3b8;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.privilege-status-text {
  font-size: 24rpx;
  color: #64748b;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.privilege-detail-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.link-text {
  font-size: 24rpx;
  color: #0f5bd8;
  font-weight: 600;
}

.link-arrow {
  font-size: 24rpx;
  color: #0f5bd8;
  font-weight: 600;
  font-family: monospace;
}

/* 3. 数据资产四格统计卡片 */
.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #ffffff;
  border-radius: 24rpx;
  border: 1rpx solid #eef2f6;
  padding: 26rpx 10rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.02);
}

.stat-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.stat-number {
  font-size: 36rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 4rpx;
  line-height: 1.2;
}

.num-blue {
  color: #0f5bd8;
}

.num-gold {
  color: #d97706;
}

.num-with-dot {
  position: relative;
  display: inline-flex;
  align-items: center;
}

.unread-blue-dot {
  position: absolute;
  top: -4rpx;
  right: -14rpx;
  width: 12rpx;
  height: 12rpx;
  background: #0f5bd8;
  border-radius: 50%;
}

.stat-title {
  font-size: 24rpx;
  color: #64748b;
  white-space: nowrap;
}

/* 4. 极客黑卡 SVIP 尊享卡片 */
.black-vip-card {
  background-color: #141c2c;
  border-radius: 32rpx;
  padding: 34rpx 28rpx 30rpx;
  color: #ffffff;
  position: relative;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.25);
  margin-bottom: 24rpx;
}

.vip-top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.vip-brand-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.vip-gold-box {
  width: 76rpx;
  height: 76rpx;
  background: linear-gradient(135deg, #ffc53d 0%, #f59e0b 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 14rpx rgba(245, 158, 11, 0.35);
}

.vip-medal-icon {
  width: 50rpx;
  height: 50rpx;
  display: block;
}

.vip-brand-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  margin-right: 14rpx;
}

.vip-honor-pill {
  background: rgba(255, 190, 26, 0.14);
  border: 1.5rpx solid rgba(255, 190, 26, 0.45);
  color: #ffbe1a;
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.vip-renew-btn {
  display:flex;
  align-items: center;
  background: linear-gradient(135deg, #ffbe1a 0%, #f59e0b 100%);
  color: #111827;
  border-radius: 999rpx;
  padding: 12rpx 14rpx;
  gap: 6rpx;
  white-space: nowrap;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(245, 158, 11, 0.35);
}

.renew-text {
  font-size: 27rpx;
  font-weight: 800;
  color: #111827;
  line-height: 1;
}

.renew-arrow {
  font-family: monospace;
  font-size: 25rpx;
  font-weight: 800;
  color: #111827;
  line-height: 1;
}

.vip-desc-text {
  font-size: 25rpx;
  color: #cbd5e1;
  margin-top: 22rpx;
  margin-bottom: 24rpx;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 0.2rpx;
}

.vip-divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.08);
  margin-bottom: 24rpx;
}

.vip-features-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.vip-feature-item {
  flex: 1;
  min-width: 0;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(245, 158, 11, 0.32);
  border-radius: 20rpx;
  padding: 12rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  white-space: nowrap;
}

.vip-feature-svg {
  width: 28rpx;
  height: 28rpx;
  display: block;
  flex-shrink: 0;
}

.feature-label {
  font-size: 23rpx;
  color: #f8fafc;
  font-weight: 500;
  white-space: nowrap;
  letter-spacing: 0.2rpx;
}

/* 5. 资源与资产管理 (4 项工具) */
.asset-tools-card {
  background: #ffffff;
  border-radius: 28rpx;
  border: 1rpx solid #eef2f6;
  padding: 26rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.02);
}

.card-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.header-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}

.header-sub {
  font-size: 24rpx;
  color: #94a3b8;
}

.tools-grid {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.tool-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.tool-icon-img {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.tool-label {
  font-size: 24rpx;
  color: #334155;
  font-weight: 500;
  white-space: nowrap;
}

/* 6. 每日任务 & 福利中心 (1:1 像素级还原) */
.daily-task-welfare-card {
  background: #ffffff;
  border-radius: 28rpx;
  border: 1rpx solid #eef2f6;
  padding: 30rpx 24rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.025);
}

.task-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.task-title-group {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.task-header-check-icon {
  width: 38rpx;
  height: 38rpx;
  display: block;
  flex-shrink: 0;
}

.task-main-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -0.5rpx;
}

.task-rule-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.rule-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #0263e0;
}

.rule-question-icon {
  width: 26rpx;
  height: 26rpx;
  display: block;
  flex-shrink: 0;
}

.header-sub-text {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 600;
  letter-spacing: 0.2rpx;
}

.task-items-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-item-box {
  background: #f8fafd;
  border: 1rpx solid #eef2f8;
  border-radius: 22rpx;
  padding: 22rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.task-left-info {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.task-icon-box {
  width: 82rpx;
  height: 82rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.box-blue {
  background: #e0eaff;
}

.box-green {
  background: #d1fae5;
}

.task-sub-icon {
  width: 42rpx;
  height: 42rpx;
  display: block;
}

.task-text-group {
  flex: 1;
  min-width: 0;
}

.task-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.task-item-name {
  font-size: 29rpx;
  font-weight: 800;
  color: #0f172a;
  white-space: nowrap;
}

.task-bean-badge {
  font-size: 21rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  white-space: nowrap;
  flex-shrink: 0;
  line-height: 1.3;
}

.badge-orange {
  background: #ffedd5;
  color: #d97706;
}

.badge-green {
  background: #d1fae5;
  color: #059669;
}

.task-item-desc {
  font-size: 23rpx;
  color: #64748b;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.35;
}

.task-action-wrap {
  flex-shrink: 0;
  width: 144rpx;
  display: flex;
  justify-content: flex-end;
}

.task-btn-solid {
  width: 144rpx !important;
  min-width: 144rpx !important;
  height: 56rpx !important;
  line-height: 56rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  background: #0263e0;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  border-radius: 999rpx;
  text-align: center;
  border: none;
  white-space: nowrap;
  box-shadow: 0 4rpx 10rpx rgba(2, 99, 224, 0.2);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.task-btn-solid::after {
  display: none;
}

.task-btn-solid.btn-disabled {
  background: #cbd5e1;
  color: #ffffff;
  box-shadow: none;
}

.task-btn-outline {
  width: 144rpx !important;
  min-width: 144rpx !important;
  height: 56rpx !important;
  line-height: 52rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  background: #ffffff;
  color: #0263e0;
  border: 2rpx solid #0263e0;
  font-size: 25rpx;
  font-weight: 700;
  border-radius: 999rpx;
  text-align: center;
  box-sizing: border-box;
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
}

.task-btn-outline::after {
  display: none;
}

/* 7. 极客生态与支持 */
.eco-card-header {
  padding: 30rpx 26rpx 22rpx;
  margin-bottom: 0;
  border-bottom: 1rpx solid #f8fafc;
}

.section-group {
  margin-bottom: 24rpx;
}

.section-header-wrap {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-heading {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}

.list-card-box {
  background: #ffffff;
  border-radius: 28rpx;
  border: 1rpx solid #eef2f6;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.02);
}

.mb-60 {
  margin-bottom: 60rpx;
}

.list-item-row {
  display: flex;
  align-items: center;
  padding: 24rpx 26rpx;
  border-bottom: 1rpx solid #f8fafc;
}

.list-item-row.no-border {
  border-bottom: none;
}

.item-icon-box {
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.bg-blue {
  background: #eff6ff;
}

.bg-amber {
  background: #fffbeb;
}

.bg-purple {
  background: #f5f3ff;
}

.bg-green {
  background: #ecfdf5;
}

.bg-slate {
  background: #f1f5f9;
}

.bg-indigo {
  background: #eef2ff;
}

.item-svg-icon {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.item-content-wrap {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.item-main-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 4rpx;
}

.item-sub-desc {
  font-size: 22rpx;
  color: #64748b;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-right-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.item-badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.badge-blue {
  background: #eff6ff;
  color: #0f5bd8;
}

.badge-amber {
  background: #fef3c7;
  color: #d97706;
}

.status-green-text {
  font-size: 24rpx;
  color: #059669;
  font-weight: 600;
  white-space: nowrap;
}

.badge-green-pill {
  background: #dcfce7;
  color: #059669;
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
}

.item-gray-label {
  font-size: 24rpx;
  color: #94a3b8;
  white-space: nowrap;
}

.item-chevron {
  font-family: monospace;
  font-size: 26rpx;
  color: #94a3b8;
  font-weight: 800;
}

/* 交互触碰反馈 */
.btn-hover {
  opacity: 0.85;
  transform: scale(0.98);
}

.card-hover {
  background-color: #f8fafc;
}

/* 微信原生头像隐形触发层 (保持原有头像与角标样式 100% 不变) */
.avatar-invisible-btn {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  border: none;
  background: transparent;
  padding: 0;
  margin: 0;
  z-index: 5;
  border-radius: 50%;
}

.avatar-invisible-btn::after {
  border: none;
}

/* 微信昵称授权 / 修改弹窗 */
.nickname-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.nickname-modal-box {
  width: 100%;
  max-width: 620rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 36rpx;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
}

.modal-close {
  font-size: 32rpx;
  color: #94a3b8;
  padding: 8rpx;
}

.modal-tip {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 24rpx;
  line-height: 1.4;
}

.nickname-input-wrap {
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
