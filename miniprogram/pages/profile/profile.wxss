/* pages/profile/profile.wxss */
.profile-container {
  padding: 24rpx;
}

/* 用户卡片 */
.user-card {
  background: #ffffff;
  border-radius: 24rpx;
  border: 1rpx solid #e2e8f0;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
}

.user-main {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar-wrap {
  position: relative;
  margin-right: 24rpx;
}

.avatar-box {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  background: #eff6ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
}

.online-badge {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 20rpx;
  height: 20rpx;
  background: #10b981;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
}

.nick-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.nick-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #0f172a;
  margin-right: 12rpx;
}

.level-badge {
  font-size: 22rpx;
  background: #f1f5f9;
  color: #475569;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  border: 1rpx solid #e2e8f0;
}

.uid-row {
  display: flex;
  align-items: center;
}

.uid-text {
  font-size: 24rpx;
  color: #94a3b8;
  font-family: monospace;
  margin-right: 12rpx;
}

.copy-btn {
  font-size: 24rpx;
  color: #3B82F6;
}

.privilege-bar {
  border-top: 1rpx solid #f1f5f9;
  padding-top: 16rpx;
}

.privilege-tip {
  font-size: 24rpx;
  color: #64748b;
}

/* 统计卡片 */
.stat-card {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #e2e8f0;
  padding: 24rpx 10rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.stat-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #0f172a;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #64748b;
}

/* VIP Banner */
.vip-banner {
  background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
  border-radius: 20rpx;
  padding: 26rpx;
  color: #ffffff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.vip-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #fef08a;
  margin-bottom: 6rpx;
}

.vip-sub {
  font-size: 24rpx;
  color: #94a3b8;
}

.vip-btn {
  background: #fef08a;
  color: #854d0e;
  font-size: 24rpx;
  font-weight: bold;
  padding: 8rpx 22rpx;
  border-radius: 20rpx;
}

/* 菜单列表 */
.menu-card {
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #e2e8f0;
  margin-bottom: 40rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 34rpx;
  margin-right: 20rpx;
}

.menu-title {
  flex: 1;
  font-size: 28rpx;
  color: #1e293b;
}

.menu-arrow {
  font-size: 24rpx;
  color: #cbd5e1;
}

.version-footer {
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
  padding-bottom: 40rpx;
}
