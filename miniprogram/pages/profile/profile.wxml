<!-- pages/profile/profile.wxml -->
<view class="profile-container">
  <!-- 用户卡片 -->
  <view class="user-card">
    <view class="user-main">
      <view class="avatar-wrap">
        <view class="avatar-box">🧑‍💻</view>
        <view class="online-badge"></view>
      </view>
      <view class="user-info">
        <view class="nick-row">
          <text class="nick-text">{{userInfo.nickName}}</text>
          <text class="level-badge">{{userInfo.level}}</text>
        </view>
        <view class="uid-row" bindtap="copyUID">
          <text class="uid-text">UID: {{userInfo.uid}}</text>
          <text class="copy-btn">复制</text>
        </view>
      </view>
    </view>
    <view class="privilege-bar">
      <text class="privilege-tip">💡 每日可享受 2 次基础免解压高速获取权益</text>
    </view>
  </view>

  <!-- 数据统计四格 -->
  <view class="stat-card">
    <view class="stat-item">
      <text class="stat-num">{{userInfo.downloadCount}}</text>
      <text class="stat-label">已获取</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{userInfo.favCount}}</text>
      <text class="stat-label">我的收藏</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{userInfo.ticketCount}}</text>
      <text class="stat-label">求档工单</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{userInfo.points}}</text>
      <text class="stat-label">极客积分</text>
    </view>
  </view>

  <!-- 专属直链加速卡 Banner -->
  <view class="vip-banner">
    <view class="vip-left">
      <view class="vip-title">⚡ 极客高速直链加速卡</view>
      <view class="vip-sub">免网盘客户端直接浏览器提取 · 满速不限流</view>
    </view>
    <view class="vip-btn">去了解 ➔</view>
  </view>

  <!-- 功能菜单列表 -->
  <view class="menu-card">
    <view class="menu-item" bindtap="viewHistory">
      <text class="menu-icon">📂</text>
      <text class="menu-title">离线资源转存与下载记录</text>
      <text class="menu-arrow">➔</text>
    </view>
    <view class="menu-item" bindtap="contactAdmin">
      <text class="menu-icon">💬</text>
      <text class="menu-title">资源报错纠错与求资源工单</text>
      <text class="menu-arrow">➔</text>
    </view>
    <view class="menu-item" bindtap="clearCache">
      <text class="menu-icon">🧹</text>
      <text class="menu-title">清理本地缓存</text>
      <text class="menu-arrow">➔</text>
    </view>
    <view class="menu-item">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-title">关于极客资源盒 v2.0</text>
      <text class="menu-arrow">➔</text>
    </view>
  </view>

  <view class="version-footer">
    <text>极客资源盒 · 原生微信小程序版</text>
  </view>
</view>
