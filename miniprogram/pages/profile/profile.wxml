<!-- pages/profile/profile.wxml -->
<view class="profile-page">

  <!-- 1. 自定义顶部导航栏 (适配状态栏与胶囊对齐) -->
  <view class="custom-nav-bar" style="padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + navBarHeight}}px;">
    <view class="nav-content" style="height: {{navBarHeight}}px; padding-right: {{menuButtonRight}}px;">
      <view class="nav-title-box">
        <text class="nav-title">个人中心</text>
        <view class="nav-badge-pro">PRO</view>
      </view>
    </view>
  </view>

  <!-- 导航栏占位 -->
  <view class="nav-placeholder" style="height: {{statusBarHeight + navBarHeight}}px;"></view>

  <!-- 主体可滚动区域 -->
  <view class="profile-body">

    <!-- 2. 用户身份特权卡片 -->
    <view class="user-id-card">
      <view class="user-top-row">
        <!-- 头像与在线认证角标 -->
        <view class="avatar-wrap">
          <image class="avatar-img" src="{{userInfo.avatar}}" mode="aspectFill" />
          <view class="avatar-verified-badge"></view>
          <!-- 微信原生选择头像透明触发按钮 -->
          <button class="avatar-invisible-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar"></button>
        </view>

        <!-- 昵称、SVIP标签与UID -->
        <view class="user-meta-wrap">
          <view class="name-svip-row">
            <text class="user-nickname" bindtap="onOpenNicknameModal">{{userInfo.nickName}}</text>
            <!-- 仅在开通付费会员时展示 SVIP 尊贵标识 -->
            <view wx:if="{{userInfo.isSvip}}" class="svip-badge">
              <image class="svip-flash-icon" src="/images/icon_flash_white.svg" mode="aspectFit" />
              <text class="svip-text">SVIP</text>
            </view>
            <!-- 未开通会员时展示普通用户标签，无 SVIP 标识 -->
            <view wx:else class="normal-user-tag">
              <text class="normal-tag-text">普通用户</text>
            </view>
          </view>
          <view class="uid-row" bindtap="copyUID" hover-class="btn-hover">
            <view class="uid-capsule">
              <text class="uid-label">UID: {{userInfo.uid}}</text>
              <image class="copy-icon" src="/images/icon_copy.svg" mode="aspectFit" />
            </view>
          </view>
        </view>

        <!-- 右侧设置按钮 -->
        <view class="settings-btn" bindtap="openSettings" hover-class="btn-hover">
          <image class="settings-icon" src="/images/icon_gear.svg" mode="aspectFit" />
        </view>
      </view>

      <!-- 底部特权说明状态与明细链接 -->
      <view class="user-bottom-row">
        <view class="privilege-status-left">
          <view class="{{userInfo.isSvip ? 'green-status-dot' : 'gray-status-dot'}}"></view>
          <text class="privilege-status-text">{{userInfo.isSvip ? (userInfo.privilegeStatus || '极客黑卡尊享中 · 独家节点生效中') : '普通用户 · 开通会员享全站无广'}}</text>
        </view>
        <!-- <view class="privilege-detail-link" bindtap="openPrivilegeDetails" hover-class="btn-hover">
          <text class="link-text">{{userInfo.isSvip ? '权益明细' : '开通特权'}}</text>
          <text class="link-arrow">></text>
        </view> -->
      </view>
    </view>

    <!-- 3. 数据资产四格统计卡片 -->
    <view class="stats-card">
      <view class="stat-col" bindtap="onToolTap" data-id="history" hover-class="btn-hover">
        <text class="stat-number">{{userInfo.downloadCount}}</text>
        <text class="stat-title">已获取</text>
      </view>
      <view class="stat-col" bindtap="onToolTap" data-id="fav" hover-class="btn-hover">
        <text class="stat-number">{{userInfo.favCount}}</text>
        <text class="stat-title">我的收藏</text>
      </view>
      <view class="stat-col has-badge" bindtap="onToolTap" data-id="ticket" hover-class="btn-hover">
        <view class="num-with-dot">
          <text class="stat-number num-blue">{{userInfo.ticketCount}}</text>
          <view wx:if="{{userInfo.ticketHasNew}}" class="unread-blue-dot"></view>
        </view>
        <text class="stat-title">求资源工单</text>
      </view>
      <view class="stat-col" bindtap="onDailyTaskTap" hover-class="btn-hover">
        <text class="stat-number num-gold">{{userInfo.points}}</text>
        <text class="stat-title">极客云豆</text>
      </view>
    </view>

    <!-- 4. 极客黑卡 SVIP 尊享/开通卡片 -->
    <view class="black-vip-card">
      <view class="vip-top-row">
        <view class="vip-brand-left">
          <view class="vip-gold-box">
            <image class="vip-medal-icon" src="/images/vip_badge_icon.svg" mode="aspectFit" />
          </view>
          <text class="vip-brand-name">{{userInfo.isSvip ? (userInfo.vipPlanName || '极客黑卡 SVIP') : '极客黑卡 SVIP'}}</text>
          <view class="vip-honor-pill">{{userInfo.isSvip ? '尊享特权' : '未开通'}}</view>
        </view>
        <view class="vip-renew-btn" bindtap="onRenewVip" hover-class="btn-hover">
          <text class="renew-text">{{userInfo.isSvip ? '立即续费' : '立即开通'}}</text>
          <text class="renew-arrow">></text>
        </view>
      </view>

      <view class="vip-desc-text">{{userInfo.isSvip ? ('到期时间：' + (userInfo.vipExpireDate || '终身永久有效')) : '开通立享无限制高速直链通道 · 失效资源 10 分钟极速补档'}}</view>

      <!-- 细线分割 -->
      <view class="vip-divider"></view>

      <!-- 底部三大权益胶囊 -->
      <view class="vip-features-row">
        <view class="vip-feature-item">
          <image class="vip-feature-svg" src="/images/vip_feature_lightning.svg" mode="aspectFit" />
          <text class="feature-label">免等待直连</text>
        </view>
        <view class="vip-feature-item">
          <image class="vip-feature-svg" src="/images/vip_feature_verify.svg" mode="aspectFit" />
          <text class="feature-label">官方正版校验</text>
        </view>
        <view class="vip-feature-item">
          <image class="vip-feature-svg" src="/images/vip_feature_support.svg" mode="aspectFit" />
          <text class="feature-label">专人极速补档</text>
        </view>
      </view>
    </view>

    <!-- 5. 资源与资产管理 (4 项工具) -->
    <view class="asset-tools-card">
      <view class="task-card-header">
        <view class="task-title-group">
          <image class="task-header-check-icon" src="/images/title_icon_asset.svg" mode="aspectFit" />
          <text class="task-main-title">资源与资产管理</text>
        </view>
        <view class="header-sub-text">4 项工具</view>
      </view>
      <view class="tools-grid">
        <block wx:for="{{assetTools}}" wx:key="id">
          <view class="tool-item" bindtap="onToolTap" data-id="{{item.id}}" hover-class="btn-hover">
            <view class="tool-icon-wrap" style="background-color: {{item.bg}};">
              <image class="tool-icon-img" src="{{item.icon}}" mode="aspectFit" />
            </view>
            <text class="tool-label">{{item.title}}</text>
          </view>
        </block>
      </view>
    </view>

    <!-- 6. 每日任务 & 福利中心 (1:1 像素级还原) -->
    <view class="daily-task-welfare-card">
      <!-- 顶部标题栏 -->
      <view class="task-card-header">
        <view class="task-title-group">
          <image class="task-header-check-icon" src="/images/task_title_check.svg" mode="aspectFit" />
          <text class="task-main-title">每日任务 & 福利中心</text>
        </view>
        <view class="task-rule-btn" bindtap="onTaskRuleTap" hover-class="btn-hover">
          <text class="rule-text">规则说明</text>
          <image class="rule-question-icon" src="/images/icon_question_blue.svg" mode="aspectFit" />
        </view>
      </view>

      <!-- 任务列表容器 -->
      <view class="task-items-list">
        <!-- 任务 1: 每日极客打卡 -->
        <view class="task-item-box">
          <view class="task-left-info">
            <view class="task-icon-box box-blue">
              <image class="task-sub-icon" src="/images/task_checkin_calendar.svg" mode="aspectFit" />
            </view>
            <view class="task-text-group">
              <view class="task-name-row">
                <text class="task-item-name">每日极客打卡</text>
                <view class="task-bean-badge badge-orange">+5 云豆</view>
              </view>
              <view class="task-item-desc">{{isCheckIn ? '今日已签到 · 连续签到享周末双倍' : '今日未签到 · 连续签到享周末双倍'}}</view>
            </view>
          </view>
          <view class="task-action-wrap">
            <view class="task-btn-solid {{isCheckIn ? 'btn-disabled' : ''}}" bindtap="onDailyCheckIn" hover-class="{{isCheckIn ? '' : 'btn-hover'}}">
              {{isCheckIn ? '已打卡' : '立即打卡'}}
            </view>
          </view>
        </view>

        <!-- 任务 2: 邀请好友助力 -->
        <view class="task-item-box">
          <view class="task-left-info">
            <view class="task-icon-box box-green">
              <image class="task-sub-icon" src="/images/task_invite_user.svg" mode="aspectFit" />
            </view>
            <view class="task-text-group">
              <view class="task-name-row">
                <text class="task-item-name">邀请好友助力</text>
                <view class="task-bean-badge badge-green">+50 云豆</view>
              </view>
              <view class="task-item-desc">成功邀请 1 人还可领 1 天体验黑卡</view>
            </view>
          </view>
          <view class="task-action-wrap">
            <button class="task-btn-outline" open-type="share" hover-class="btn-hover" style="width: 144rpx !important; min-width: 144rpx !important; height: 56rpx !important; line-height: 52rpx !important; padding: 0 !important; margin: 0 !important;">
              去邀请
            </button>
          </view>
        </view>
      </view>
    </view>

    <!-- 7. 极客生态与支持 -->
    <view class="list-card-box mb-60">
      <view class="task-card-header eco-card-header">
        <view class="task-title-group">
          <image class="task-header-check-icon" src="/images/title_icon_eco.svg" mode="aspectFit" />
          <text class="task-main-title">生态与支持</text>
        </view>
        <view class="header-sub-text">官方自营保障</view>
      </view>

      <!-- 生态 1: 社群 -->
      <view class="list-item-row" bindtap="onCommunityTap" hover-class="card-hover">
        <view class="item-icon-box bg-blue">
          <image class="item-svg-icon" src="/images/eco_group.svg" mode="aspectFit" />
        </view>
        <view class="item-content-wrap">
          <view class="item-main-title">官方极客交流社群</view>
        </view>
        <view class="item-right-wrap">
          <text class="item-gray-label">扫码加入 3 群</text>
          <text class="item-chevron">></text>
        </view>
      </view>

      <!-- 生态 2: 资源失效反馈/建议 -->
      <view class="list-item-row" bindtap="onFeedbackTap" hover-class="card-hover">
        <view class="item-icon-box bg-blue">
          <image class="item-svg-icon" src="/images/eco_feedback.svg" mode="aspectFit" />
        </view>
        <view class="item-content-wrap">
          <view class="item-main-title">资源失效反馈/建议</view>
        </view>
        <view class="item-right-wrap">
          <text class="item-gray-label">专人极速补档</text>
          <text class="item-chevron">></text>
        </view>
      </view>

      <!-- 生态 3: 求资源入口 -->
      <view class="list-item-row" bindtap="onRequestResourceTap" hover-class="card-hover">
        <view class="item-icon-box bg-blue">
          <image class="item-svg-icon" src="/images/eco_request.svg" mode="aspectFit" />
        </view>
        <view class="item-content-wrap">
          <view class="item-main-title">求资源 / 愿望清单征集</view>
        </view>
        <view class="item-right-wrap">
          <text class="item-gray-label">全网搜罗上架</text>
          <text class="item-chevron">></text>
        </view>
      </view>

      <!-- 生态 2: 免责声明 -->
      <view class="list-item-row" bindtap="onDisclaimerTap" hover-class="card-hover">
        <view class="item-icon-box bg-blue">
          <image class="item-svg-icon" src="/images/eco_shield.svg" mode="aspectFit" />
        </view>
        <view class="item-content-wrap">
          <view class="item-main-title">免责声明与侵权下架通道</view>
        </view>
        <view class="item-right-wrap">
          <text class="item-chevron">></text>
        </view>
      </view>

      <!-- 生态 3: 客服 -->
      <view class="list-item-row" bindtap="onCustomerServiceTap" hover-class="card-hover">
        <view class="item-icon-box bg-blue">
          <image class="item-svg-icon" src="/images/eco_service.svg" mode="aspectFit" />
        </view>
        <view class="item-content-wrap">
          <view class="item-main-title">人工在线客服 / 意见反馈</view>
        </view>
        <view class="item-right-wrap">
          <text class="item-chevron">></text>
        </view>
      </view>

      <!-- 生态 4: 关于 -->
      <view class="list-item-row no-border" bindtap="onAboutTap" hover-class="card-hover">
        <view class="item-icon-box bg-blue">
          <image class="item-svg-icon" src="/images/eco_info.svg" mode="aspectFit" />
        </view>
        <view class="item-content-wrap">
          <view class="item-main-title">关于枫的藏宝阁</view>
        </view>
        <view class="item-right-wrap">
          <text class="item-gray-label">v2.4.0 纯净版</text>
          <text class="item-chevron">></text>
        </view>
      </view>
    </view>

  </view>

  <!-- 微信昵称授权 / 修改弹窗 -->
  <view wx:if="{{showNicknameModal}}" class="nickname-modal-mask" bindtap="onCloseNicknameModal">
    <view class="nickname-modal-box" catchtap="stopBubble">
      <view class="modal-header">
        <text class="modal-title">授权微信昵称</text>
        <text class="modal-close" bindtap="onCloseNicknameModal">✕</text>
      </view>
      <view class="modal-tip">点击下方输入框可直接快捷选择您的微信昵称：</view>
      <view class="nickname-input-wrap">
        <input 
          type="nickname" 
          class="wechat-nickname-input" 
          placeholder="请输入或点此选择微信昵称" 
          value="{{inputNickname}}" 
          bindinput="onNicknameInput"
          bindchange="onNicknameChange"
        />
      </view>
      <view class="modal-btn-row">
        <view class="btn-cancel" bindtap="onCloseNicknameModal">取消</view>
        <view class="btn-confirm" bindtap="onSaveNickname">确认保存</view>
      </view>
    </view>
  </view>
</view>
