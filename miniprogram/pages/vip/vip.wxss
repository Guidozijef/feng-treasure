/* 会员中心页面整体样式 */
page {
  background-color: #f8fafd;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  box-sizing: border-box;
}

.vip-page-container {
  padding: 16rpx 28rpx 40rpx;
  box-sizing: border-box;
}

/* 1. 顶部副标题栏 */
.vip-sub-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
  padding: 0 4rpx;
}

.sub-bar-brand {
  font-size: 26rpx;
  font-weight: 800;
  color: #0263e0;
  letter-spacing: 0.5rpx;
}

.sub-bar-right {
  display: flex;
  align-items: center;
}

.order-history-text {
  font-size: 25rpx;
  color: #475569;
  font-weight: 500;
}

/* 2. 黑金旗舰卡片 (VIP Hero Banner) */
.vip-hero-card {
  background: linear-gradient(135deg, #181b22 0%, #0d0f14 100%);
  border-radius: 28rpx;
  padding: 34rpx 28rpx 26rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.12);
  border: 1rpx solid rgba(245, 158, 11, 0.25);
  position: relative;
  overflow: hidden;
}

.vip-hero-card::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 220rpx;
  height: 220rpx;
  background: radial-gradient(circle, rgba(245, 158, 11, 0.15) 0%, rgba(245, 158, 11, 0) 70%);
  border-radius: 50%;
  pointer-events: none;
}

.hero-main-title {
  font-size: 32rpx;
  font-weight: 800;
  background: linear-gradient(90deg, #ffd770 0%, #f59e0b 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  letter-spacing: 0.2rpx;
  line-height: 1.4;
  display: block;
}

.hero-desc-text {
  font-size: 24rpx;
  color: #cbd5e1;
  line-height: 1.55;
  margin-top: 14rpx;
  margin-bottom: 24rpx;
  letter-spacing: 0.2rpx;
}

.hero-capsules-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
}

.hero-capsule {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.capsule-icon {
  font-size: 24rpx;
}

.capsule-text {
  font-size: 23rpx;
  color: #f1f5f9;
  font-weight: 600;
}

.capsule-divider {
  width: 1rpx;
  height: 22rpx;
  background: rgba(255, 255, 255, 0.15);
}

/* 3. 精选特惠套餐区域 */
.plans-section {
  margin-bottom: 24rpx;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 4rpx;
  margin-bottom: 18rpx;
}

.section-title-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.title-indicator-dot {
  width: 8rpx;
  height: 28rpx;
  background: #0263e0;
  border-radius: 4rpx;
}

.section-bold-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -0.5rpx;
}

.safe-pay-sub {
  font-size: 23rpx;
  color: #64748b;
  font-weight: 500;
}

.plans-grid {
  display: flex;
  gap: 16rpx;
}

.plan-card {
  flex: 1;
  min-width: 0;
  background: #ffffff;
  border: 2rpx solid #e2e8f0;
  border-radius: 24rpx;
  padding: 36rpx 10rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.02);
  transition: all 0.2s ease;
  overflow: hidden;
}

.plan-card-active {
  border-color: #0263e0;
  background: #f0f7ff;
  box-shadow: 0 8rpx 24rpx rgba(2, 99, 224, 0.12);
}

/* 顶部特色角标 */
.plan-top-badge {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  padding: 4rpx 16rpx;
  border-bottom-left-radius: 12rpx;
  border-bottom-right-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  white-space: nowrap;
  line-height: 1.2;
}

.badge-blue {
  background: #dbeafe;
  color: #0263e0;
}

.badge-orange {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  color: #ffffff;
}

.badge-black {
  background: #0f172a;
  color: #ffffff;
}

.plan-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #1e293b;
  margin-top: 6rpx;
  white-space: nowrap;
}

.active-name {
  color: #0263e0;
}

.plan-price-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin: 12rpx 0 4rpx;
}

.currency-symbol {
  font-size: 26rpx;
  font-weight: 800;
  color: #0263e0;
  margin-right: 2rpx;
}

.price-value {
  font-size: 46rpx;
  font-weight: 800;
  color: #0263e0;
  line-height: 1;
  letter-spacing: -1.5rpx;
}

.price-unit {
  font-size: 22rpx;
  color: #64748b;
  margin-left: 2rpx;
  font-weight: 600;
}

.original-price {
  font-size: 22rpx;
  color: #94a3b8;
  text-decoration: line-through;
  margin-bottom: 12rpx;
}

.per-day-text {
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 6rpx;
  white-space: nowrap;
}

.active-per-day {
  color: #0263e0;
  font-weight: 600;
}

.extra-benefit-text {
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.benefit-cyan {
  color: #0d9488;
}

.benefit-orange {
  color: #d97706;
}

.benefit-gold {
  color: #b45309;
}

/* 选中右下角角标 */
.plan-checked-corner {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 36rpx;
  height: 36rpx;
  background: #0263e0;
  border-top-left-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.corner-check-icon {
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
}

/* 4. 限时加赠提示 Banner */
.bonus-banner {
  background: #fffbeb;
  border: 1.5rpx solid #fef3c7;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(245, 158, 11, 0.05);
}

.bonus-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.bonus-gift-icon {
  width: 38rpx;
  height: 38rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.bonus-text {
  font-size: 24rpx;
  color: #78350f;
  line-height: 1.45;
}

.bonus-highlight {
  font-weight: 800;
  color: #b45309;
}

.bonus-right-tag {
  background: #fde68a;
  color: #92400e;
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  margin-left: 14rpx;
}

/* 5. 黑卡会员 8 大极客特权 */
.privileges-section {
  margin-bottom: 28rpx;
}

.privileges-header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 0 4rpx;
  margin-bottom: 20rpx;
}

.priv-header-left {
  flex: 1;
  min-width: 0;
}

.priv-main-heading {
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -0.5rpx;
  display: block;
}

.priv-sub-desc {
  font-size: 23rpx;
  color: #64748b;
  margin-top: 4rpx;
  display: block;
}

.priv-compare-link {
  font-size: 25rpx;
  color: #0263e0;
  font-weight: 600;
  white-space: nowrap;
}

.privileges-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.priv-item-card {
  background: #ffffff;
  border: 1rpx solid #eef2f6;
  border-radius: 22rpx;
  padding: 22rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.02);
}

.priv-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.priv-icon-img {
  width: 38rpx;
  height: 38rpx;
}

.priv-text-info {
  flex: 1;
  min-width: 0;
}

.priv-item-title {
  font-size: 27rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 4rpx;
  white-space: nowrap;
}

.priv-item-desc {
  font-size: 21rpx;
  color: #64748b;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 6. 用户协议勾选栏 */
.agreement-bar {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 10rpx 4rpx;
  margin-bottom: 34rpx;
}

.checkbox-wrap {
  padding-top: 4rpx;
  flex-shrink: 0;
}

.custom-checkbox {
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid #94a3b8;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.checkbox-checked {
  background: #0263e0;
  border-color: #0263e0;
}

.checkbox-check-icon {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.agreement-text-wrap {
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.5;
}

.text-regular {
  color: #64748b;
}

.text-link {
  color: #0263e0;
  font-weight: 600;
}

/* 7. 常见问题手风琴 */
.faq-section {
  margin-bottom: 36rpx;
}

.faq-title-heading {
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.faq-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.faq-item-card {
  background: #ffffff;
  border: 1rpx solid #eef2f6;
  border-radius: 20rpx;
  overflow: hidden;
}

.faq-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 24rpx;
}

.faq-question-text {
  font-size: 27rpx;
  font-weight: 700;
  color: #1e293b;
}

.faq-arrow-wrap {
  transition: transform 0.2s ease;
}

.arrow-open {
  transform: rotate(180deg);
}

.faq-arrow {
  width: 22rpx;
  font-size: 22rpx;
  color: #64748b;
  font-weight: 700;
  font-family: monospace;
}

.faq-answer-wrap {
  padding: 0 24rpx 24rpx;
  border-top: 1rpx dashed #f1f5f9;
  padding-top: 16rpx;
}

.faq-answer-text {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
}

/* 8. 底部信任背书安全说明 */
.footer-trust-section {
  text-align: center;
  color: #94a3b8;
  font-size: 22rpx;
  line-height: 1.7;
  margin-bottom: 30rpx;
}

.trust-badge-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.trust-shield-icon {
  width: 26rpx;
  height: 26rpx;
}

.trust-text {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 500;
}

.copyright-row {
  font-size: 21rpx;
  color: #94a3b8;
}

.statement-row {
  font-size: 21rpx;
  color: #94a3b8;
}

/* 垫高高度 */
.bottom-placeholder {
  height: calc(140rpx + env(safe-area-inset-bottom));
}

/* 9. 固定吸底支付操作栏 (Fixed Bottom Bar) */
.fixed-bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(15, 23, 42, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 100;
  border-top: 1rpx solid #eef2f6;
  box-sizing: border-box;
}

.bottom-left-info {
  display: flex;
  flex-direction: column;
}

.price-top-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.total-label {
  font-size: 24rpx;
  color: #64748b;
  margin-right: 4rpx;
}

.total-currency {
  font-size: 28rpx;
  font-weight: 800;
  color: #0263e0;
}

.total-price-num {
  font-size: 48rpx;
  font-weight: 800;
  color: #0263e0;
  letter-spacing: -1.5rpx;
  line-height: 1;
}

.discount-pill {
  background: #dcfce7;
  color: #059669;
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  margin-left: 10rpx;
  line-height: 1.3;
}

.wechat-safe-tip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 4rpx;
}

.tip-check-green {
  color: #059669;
  font-size: 20rpx;
  font-weight: 800;
}

.tip-text {
  font-size: 21rpx;
  color: #94a3b8;
}

.open-vip-btn {
  background: linear-gradient(135deg, #0263e0 0%, #0850c4 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 0 44rpx;
  height: 80rpx;
  line-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-shadow: 0 6rpx 18rpx rgba(2, 99, 224, 0.3);
  border: none;
  margin: 0;
  white-space: nowrap;
}

.open-vip-btn::after {
  display: none;
}

.btn-arrow-icon {
  font-size: 26rpx;
  font-weight: 800;
}

/* 触碰交互反馈 */
.btn-hover {
  opacity: 0.85;
  transform: scale(0.98);
}

.card-tap-hover {
  opacity: 0.95;
}
