/* pages/home/home.wxss */
.container {
  padding: 24rpx;
  padding-bottom: 40rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 36rpx;
  border: 1rpx solid #e2e8f0;
  padding: 14rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.02);
}

.search-icon {
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1e293b;
}

.search-btn {
  margin-left: 16rpx;
  background: #0052d9;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 0 28rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
}

/* Banner */
.banner-card {
  background: linear-gradient(135deg, #0052d9 0%, #1e40af 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  color: #ffffff;
  margin-bottom: 28rpx;
  box-shadow: 0 10rpx 25rpx rgba(0, 82, 217, 0.25);
}

.banner-tag {
  display: inline-block;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.banner-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.banner-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-bottom: 20rpx;
}

.banner-btn {
  display: inline-block;
  background: #ffffff;
  color: #0052d9;
  font-size: 24rpx;
  font-weight: bold;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
}

/* 金刚区 */
.category-grid {
  display: flex;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  border: 1rpx solid #f1f5f9;
  margin-bottom: 24rpx;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.grid-icon-box {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.bg-blue { background: #eff6ff; }
.bg-green { background: #f0fdf4; }
.bg-orange { background: #fff7ed; }
.bg-purple { background: #faf5ff; }
.bg-cyan { background: #ecfeff; }

.grid-label {
  font-size: 24rpx;
  color: #334155;
  font-weight: 500;
}

/* 广播条 */
.notice-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #e2e8f0;
  margin-bottom: 28rpx;
}

.notice-tag {
  background: #fee2e2;
  color: #dc2626;
  font-size: 20rpx;
  font-weight: bold;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.notice-text {
  font-size: 24rpx;
  color: #64748b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 区块通用 */
.section-wrap {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.section-title {
  display: flex;
  align-items: center;
}

.title-bar {
  width: 8rpx;
  height: 28rpx;
  background: #0052d9;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #0f172a;
}

.section-more, .section-count {
  font-size: 24rpx;
  color: #0052d9;
}

.section-count {
  color: #94a3b8;
}

/* 横滑卡片 */
.horizontal-scroll {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
}

.top-card {
  display: inline-block;
  width: 440rpx;
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #e2e8f0;
  padding: 24rpx;
  margin-right: 20rpx;
  position: relative;
  vertical-align: top;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.top-card-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: #fef08a;
  color: #854d0e;
  font-size: 20rpx;
  font-weight: bold;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.top-card-header {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.top-card-icon {
  font-size: 44rpx;
  margin-right: 14rpx;
}

.top-card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1e293b;
}

.top-card-version {
  font-size: 22rpx;
  color: #0052d9;
  font-weight: 500;
}

.top-card-desc {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.4;
  white-space: normal;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  height: 68rpx;
  margin-bottom: 16rpx;
}

.top-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag-pill {
  font-size: 20rpx;
  background: #f1f5f9;
  color: #475569;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
}

.btn-get {
  background: #0052d9;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: bold;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

/* Feed 列表 */
.feed-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feed-item {
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #e2e8f0;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.feed-content {
  flex: 1;
  margin-right: 20rpx;
}

.feed-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.feed-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1e293b;
  margin-right: 12rpx;
}

.feed-badge {
  background: #eff6ff;
  color: #0052d9;
  font-size: 20rpx;
  font-weight: bold;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.feed-desc {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.4;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.feed-tags {
  display: flex;
  gap: 8rpx;
}

.tag-chip {
  font-size: 20rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  color: #64748b;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}

.tag-chip.rating {
  color: #d97706;
  font-weight: bold;
  background: #fefce8;
  border-color: #fef08a;
}

.feed-btn {
  background: #0052d9;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
  padding: 0 24rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
}
