<!-- pages/home/home.wxml -->
<view class="page-container">

  <!-- 1. 自定义顶部导航栏 (适配各设备状态栏与微信原生胶囊) -->
  <view class="custom-nav-bar" style="padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + navBarHeight}}px;">
    <view class="nav-content" style="height: {{navBarHeight}}px; padding-right: {{menuButtonRight}}px;">
      <view class="nav-brand">
        <image class="nav-logo" src="/images/logo.png" mode="aspectFit" />
        <text class="nav-title">枫的藏宝阁</text>
      </view>
    </view>
  </view>

  <!-- 导航栏占位块 -->
  <view class="nav-placeholder" style="height: {{statusBarHeight + navBarHeight}}px;"></view>

  <!-- 主体内容滚动区 -->
  <view class="content-body">

    <!-- 2. 搜索栏 (支持正常输入，点击键盘确定搜索才跳转) -->
    <view class="search-section">
      <view class="search-bar-wrap">
        <image class="search-icon" src="/images/search.svg" mode="aspectFit" bindtap="onSearchConfirm" />
        <input 
          class="search-input" 
          placeholder="{{searchPlaceholder}}" 
          placeholder-class="search-placeholder-style"
          value="{{searchKeyword}}"
          confirm-type="search"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
        />
        <text wx:if="{{searchKeyword}}" class="search-clear-cross" catchtap="onClearSearch">✕</text>
        <image class="filter-icon" src="/images/filter.svg" mode="aspectFit" catchtap="onFilterTap" hover-class="btn-hover" />
      </view>
    </view>

    <!-- 3. AI 生产力工具全集 Banner 轮播 (蓝绿渐变、光晕、企划胶囊、获取按钮、右下角药丸分页点) -->
    <view class="banner-section">
      <swiper 
        class="banner-swiper" 
        circular="true" 
        autoplay="true" 
        interval="5000" 
        duration="400" 
        bindchange="onBannerChange"
      >
        <block wx:for="{{bannerList}}" wx:key="id">
          <swiper-item>
            <view class="banner-card" bindtap="goToDetail" data-id="{{item.id}}" hover-class="card-hover">
              <!-- 右上角半透明发光几何光晕圈 -->
              <view class="banner-glow-circle"></view>
              
              <!-- 企划标签 -->
              <view class="banner-pill">
                <view class="pill-dot"></view>
                <text>{{item.tag}}</text>
              </view>

              <!-- 主副标题 -->
              <view class="banner-title">{{item.title}}</view>
              <view class="banner-sub">{{item.subTitle}}</view>

              <!-- 立即获取按钮 -->
              <view class="banner-btn-row">
                <view class="banner-btn" hover-class="btn-hover">
                  <text>{{item.btnText}}</text>
                  <text class="banner-btn-arrow">→</text>
                </view>
              </view>
            </view>
          </swiper-item>
        </block>
      </swiper>

      <!-- 仿原生右下角暗色胶囊分页指示器 -->
      <view class="banner-indicator-pill">
        <view class="indicator-dot {{bannerCurrent === 0 ? 'active' : ''}}"></view>
        <view class="indicator-dot {{bannerCurrent === 1 ? 'active' : ''}}"></view>
        <view class="indicator-dot {{bannerCurrent === 2 ? 'active' : ''}}"></view>
      </view>
    </view>

    <!-- 4. 金刚区 5 大分类导航 (独立浅彩圆角方块，完全与 UI 图 1:1) -->
    <view class="category-section">
      <view class="category-grid">
        <block wx:for="{{categories}}" wx:key="id">
          <view class="category-item" bindtap="goToCategory" data-type="{{item.id}}" hover-class="btn-hover">
            <view class="category-icon-box {{item.bgClass}}">
              <image class="category-icon-img" src="{{item.icon}}" mode="aspectFit" />
            </view>
            <text class="category-label">{{item.name}}</text>
          </view>
        </block>
      </view>
    </view>

    <!-- 5. 今日更新广播条 (喇叭 + 最新红标 + 播报文本 + 右箭头) -->
    <view class="notice-section">
      <view class="notice-bar" bindtap="onNoticeTap" hover-class="btn-hover">
        <image class="notice-icon" src="/images/horn.svg" mode="aspectFit" />
        <text class="notice-badge">最新</text>
        <text class="notice-text">{{noticeText}}</text>
        <text class="notice-arrow">></text>
      </view>
    </view>

    <!-- 6. 热门飙升榜 (横滑卡片区) -->
    <view class="section-wrap">
      <!-- 头部：火焰图标 + 热门飙升榜 + 查看更多 -->
      <view class="section-head">
        <view class="section-title-left">
          <image class="section-fire-icon" src="/images/flame.svg" mode="aspectFit" />
          <text class="section-title-text">热门飙升榜</text>
        </view>
        <view class="section-more-link" bindtap="goToHot" hover-class="btn-hover">
          查看更多 >
        </view>
      </view>

      <!-- 横滑卡片列表 -->
      <scroll-view class="hot-scroll-view" scroll-x="true" enable-flex="true" show-scrollbar="false">
        <block wx:for="{{topPicks}}" wx:key="id">
          <view class="hot-card" bindtap="goToDetail" data-id="{{item.id}}" hover-class="card-hover">
            <!-- 头部：图标与 TOP 排名徽章 (根据热度排名自动展示，非静态标签字段) -->
            <view class="hot-card-header">
              <view class="hot-card-icon-box" style="background-color: {{item.iconBg || '#edf5ff'}};">
                <image class="hot-card-icon-img" src="{{item.icon || '/images/cloud.svg'}}" mode="aspectFit" />
              </view>
              <view class="hot-card-badge rank-badge-{{index + 1}}">
                <text class="rank-badge-text">{{item.rankBadge || ('TOP ' + (index + 1))}}</text>
              </view>
            </view>

            <view class="hot-card-title">{{item.title}}</view>
            <view class="hot-card-desc">
              <text class="hot-card-tag-pill" wx:if="{{item.badge && item.badge !== 'TOP 1' && item.badge !== 'TOP 2' && item.badge !== 'TOP 3'}}">{{item.badge}}</text>
              <text class="hot-card-desc-text">{{item.desc}}</text>
            </view>

            <!-- 底部：人数与获取 -->
            <view class="hot-card-footer">
              <text class="hot-card-downloads">{{item.downloads}}</text>
              <text class="hot-card-get-btn" catchtap="goToDetail" data-id="{{item.id}}" hover-class="btn-hover">获取</text>
            </view>
          </view>
        </block>
      </scroll-view>
    </view>

    <!-- 7. 综合精选 Tabs 与资源 Feed 列表 -->
    <view class="feed-section">
      <!-- Tabs 切换头 -->
      <view class="tabs-header-wrap">
        <view class="tabs-nav-list">
          <block wx:for="{{tabs}}" wx:key="id">
            <view 
              class="tab-item {{activeTab === item.id ? 'active' : ''}}" 
              bindtap="onTabChange" 
              data-id="{{item.id}}" 
              data-name="{{item.name}}"
            >
              <text class="tab-text">{{item.name}}</text>
              <view class="tab-indicator" wx:if="{{activeTab === item.id}}"></view>
            </view>
          </block>
        </view>
        <text class="tabs-total-count">共 {{totalCount}} 资源</text>
      </view>

      <!-- 5 款精选卡片 Feed 列表 (与 UI 图完全对齐) -->
      <view class="feed-card-list">
        <block wx:for="{{feedList}}" wx:key="id">
          <view class="feed-card" bindtap="goToDetail" data-id="{{item.id}}" hover-class="card-hover">
            <!-- 左侧分类图标 -->
            <view class="feed-icon-wrap">
              <image class="feed-icon-img" src="{{item.icon}}" mode="aspectFit" />
            </view>

            <!-- 中间内容区 -->
            <view class="feed-body-wrap">
              <!-- 顶部行: 标题优先完整展示，右侧轻量视觉角标 -->
              <view class="feed-card-top-row">
                <text class="feed-title-text">{{item.title}}</text>
                <!-- <text wx:if="{{item.badge}}" class="global-visual-badge">{{item.badge}}</text> -->
              </view>

              <!-- 第二行: 最多展示 1-2 个精炼细分标签，或展示简介 -->
              <view class="feed-mid-row">
                <view class="feed-tags-row" wx:if="{{item.tags && item.tags.length > 0}}">
                  <block wx:for="{{item.tags}}" wx:for-item="tag" wx:key="text">
                    <text wx:if="{{index < 3}}" class="feed-tag-pill tag-{{tag.type || 'blue'}}">{{tag.text}}</text>
                  </block>
                </view>
                <view class="feed-desc-text" wx:elif="{{item.desc}}">{{item.desc}}</view>
              </view>

              <!-- 基础规格: 平台 + 体积 + 评分 -->
              <view class="feed-meta-row">
                <text wx:if="{{item.platform}}" class="meta-pill pill-blue">{{item.platform}}</text>
                <text wx:if="{{item.size}}" class="meta-pill pill-gray">{{item.size}}</text>
                <text wx:if="{{item.rating}}" class="meta-star">⭐ {{item.rating}}</text>
              </view>
            </view>

            <!-- 右侧深蓝胶囊获取按钮 -->
            <view class="feed-get-btn" catchtap="goToDetail" data-id="{{item.id}}" hover-class="btn-hover">
              获取
            </view>
          </view>
        </block>
      </view>
    </view>

  </view>

  <!-- 8. 原生交互：极速获取转存 / 复制链接弹窗 -->
  <view class="resource-modal-mask" wx:if="{{showModal}}" bindtap="closeModal">
    <view class="resource-modal-sheet" catchtap="true">
      <view class="modal-drag-bar"></view>
      <view class="modal-header">
        <view class="modal-title-box">
          <text class="modal-badge" wx:if="{{selectedResource.badge}}">{{selectedResource.badge}}</text>
          <view class="modal-title">{{selectedResource.title}}</view>
        </view>
        <view class="modal-close" bindtap="closeModal">×</view>
      </view>

      <view class="modal-info-box">
        <view class="modal-info-row" wx:if="{{selectedResource.size}}">
          <text class="info-label">文件大小</text>
          <text class="info-val">{{selectedResource.size}}</text>
        </view>
        <view class="modal-info-row" wx:if="{{selectedResource.rating}}">
          <text class="info-label">资源评分</text>
          <text class="info-val" style="color: #d97706; font-weight: bold;">⭐ {{selectedResource.rating}} 高分</text>
        </view>
        <view class="modal-info-row" wx:if="{{selectedResource.platform}}">
          <text class="info-label">适用平台</text>
          <text class="info-val">{{selectedResource.platform}}</text>
        </view>
        <view class="modal-info-row">
          <text class="info-label">网盘链接</text>
          <text class="info-val link-text">{{selectedResource.link}}</text>
        </view>
        <view class="modal-info-row">
          <text class="info-label">提取密码</text>
          <text class="info-val code-text">{{selectedResource.code || 'geek'}}</text>
        </view>
      </view>

      <view class="modal-actions">
        <button class="modal-copy-btn" bindtap="copyResourceLink" hover-class="btn-hover">
          一键复制网盘链接与提取码
        </button>
        <view class="modal-detail-link" bindtap="goToDetail" data-id="{{selectedResource.id}}">
          查看完整版本说明与更新日志 ➔
        </view>
      </view>
    </view>
  </view>

</view>
