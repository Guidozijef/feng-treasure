/* pages/category/category.wxss */
.category-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 顶部搜索 */
.cat-top-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e2e8f0;
}

.cat-search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f1f5f9;
  border-radius: 30rpx;
  padding: 12rpx 20rpx;
}

.cat-search-input {
  flex: 1;
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #1e293b;
}

.cat-filter-btn {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #3B82F6;
  font-weight: bold;
}

/* 主体左右布局 */
.cat-main {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* 左侧边栏 */
.cat-sidebar {
  width: 170rpx;
  background: #f8fafc;
  border-right: 1rpx solid #e2e8f0;
  height: 100%;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 10rpx;
  border-bottom: 1rpx solid #f1f5f9;
  position: relative;
}

.nav-item.active {
  background: #ffffff;
  color: #3B82F6;
  font-weight: bold;
}

.nav-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20rpx;
  bottom: 20rpx;
  width: 6rpx;
  background: #3B82F6;
  border-radius: 0 4rpx 4rpx 0;
}

.nav-icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
}

.nav-text {
  font-size: 26rpx;
}

/* 右侧内容 */
.cat-content {
  flex: 1;
  height: 100%;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 细分场景 */
.sub-scene-card {
  background: #ffffff;
  border-radius: 16rpx;
  border: 1rpx solid #e2e8f0;
  padding: 16rpx;
  margin-bottom: 20rpx;
}

.sub-scene-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #475569;
  margin-bottom: 12rpx;
}

.sub-scene-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.tag-cell {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 10rpx;
  text-align: center;
  font-size: 24rpx;
  padding: 10rpx 6rpx;
  color: #475569;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tag-cell.active {
  background: #eff6ff;
  border-color: #bfdbfe;
  color: #3B82F6;
  font-weight: bold;
}

/* 排序 */
.sort-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 24rpx;
}

.sort-options {
  display: flex;
  gap: 20rpx;
}

.sort-item {
  color: #64748b;
  white-space: nowrap;
}

.sort-item.active {
  color: #3B82F6;
  font-weight: bold;
}

.total-count {
  color: #94a3b8;
  font-size: 24rpx;
  white-space: nowrap;
}

/* 资源列表 */
.resource-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.res-card {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 22rpx;
  display: flex;
  align-items: center;
}

.res-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 22rpx;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.res-info {
  flex: 1;
  min-width: 0;
}

.res-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.res-title {
  font-size: 29rpx;
  font-weight: bold;
  color: #1e293b;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 10rpx;
}

.res-badge {
  font-size: 22rpx;
  color: #3B82F6;
  background: #eff6ff;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.res-desc {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 14rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
  text-overflow: ellipsis;
}

.res-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10rpx;
}

.res-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.pill {
  font-size: 22rpx;
  background: #f1f5f9;
  color: #475569;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  white-space: nowrap;
  flex-shrink: 0;
  line-height: 1.25;
}

.pill.star {
  color: #d97706;
  font-weight: bold;
  background: #fefce8;
  white-space: nowrap;
  flex-shrink: 0;
}

.res-get-btn {
  background: #3B82F6;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: bold;
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.footer-tip {
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
  padding: 30rpx 0 60rpx;
}

/* 抽屉浮层 */
.drawer-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.drawer-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.drawer-panel {
  position: fixed;
  right: 0;
  top: 0;
  bottom: 0;
  width: 580rpx;
  background: #ffffff;
  z-index: 101;
  transform: translateX(100%);
  transition: transform 0.3s;
  display: flex;
  flex-direction: column;
}

.drawer-panel.show {
  transform: translateX(0);
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #e2e8f0;
}

.drawer-title {
  font-size: 32rpx;
  font-weight: bold;
}

.drawer-close {
  font-size: 36rpx;
  color: #94a3b8;
}

.drawer-body {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
}

.filter-section {
  margin-bottom: 30rpx;
}

.filter-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #334155;
  margin-bottom: 16rpx;
}

.filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e2e8f0;
  font-size: 26rpx;
  color: #475569;
}

.chip.active {
  background: #3B82F6;
  color: #ffffff;
  border-color: #3B82F6;
  font-weight: bold;
}

.drawer-footer {
  display: flex;
  padding: 20rpx 30rpx;
  gap: 16rpx;
  border-top: 1rpx solid #e2e8f0;
}

.drawer-reset-btn {
  flex: 1;
  background: #f1f5f9;
  color: #475569;
  font-size: 28rpx;
  border-radius: 16rpx;
}

.drawer-confirm-btn {
  flex: 2;
  background: #3B82F6;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 16rpx;
}
