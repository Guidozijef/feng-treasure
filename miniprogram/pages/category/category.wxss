/* 分类页面 (资源库 1:1 像素级精细化还原) */
page {
  background-color: #ffffff;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  box-sizing: border-box;
  height: 100vh;
  overflow: hidden;
}

.category-page-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  width: 100%;
}

/* 1. 自定义顶部导航栏 */
.custom-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  z-index: 500;
  display: flex;
  flex-direction: column;
  box-shadow: 0 1rpx 0 rgba(0, 0, 0, 0.04);
}

.nav-content-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  position: relative;
  width: 100%;
  box-sizing: border-box;
}

.nav-back-action {
  width: 64rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  flex-shrink: 0;
}

.nav-back-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.nav-center-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.title-main-text {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: 1rpx;
}

.title-blue-dot {
  font-size: 15rpx;
  color: #0263e0;
  line-height: 1;
  margin-top: 2rpx;
}

.nav-bar-placeholder {
  width: 100%;
  flex-shrink: 0;
}

/* 2. 顶部搜索栏与高级筛选按钮 */
.cat-top-search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 24rpx 10rpx;
  background: #ffffff;
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
}

.cat-search-capsule {
  flex: 1;
  background: #ffffff;
  border: 1.5rpx solid #e2e8f0;
  border-radius: 999rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  gap: 12rpx;
  box-sizing: border-box;
}

.search-glass-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  opacity: 0.65;
}

.search-text-input {
  flex: 1;
  font-size: 25rpx;
  color: #0f172a;
  height: 100%;
}

.search-input-placeholder {
  font-size: 25rpx;
  color: #94a3b8;
  font-weight: 400;
}

.search-clear-cross {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 400;
  padding: 6rpx 8rpx;
  flex-shrink: 0;
  line-height: 1;
}

.cat-filter-slider-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  background: #eff6ff;
  border: 1.5rpx solid #dbeafe;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  position: relative;
}

.cat-filter-slider-btn.filter-btn-active {
  background: #0263e0;
  border-color: #0263e0;
  box-shadow: 0 4rpx 14rpx rgba(2, 99, 224, 0.28);
}

.cat-filter-slider-btn.filter-btn-active .filter-slider-svg {
  filter: brightness(0) invert(1);
}

.filter-count-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: #ea580c;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 800;
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
  border: 2rpx solid #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(234, 88, 12, 0.3);
}

.filter-slider-svg {
  width: 36rpx;
  height: 36rpx;
}

/* 3. 已激活多维筛选条件栏 (仅在有筛选生效时显示) */
.active-filters-bar {
  background: #f8fafc;
  border-bottom: 1rpx solid #f1f5f9;
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
}

.active-filters-scroll {
  width: 100%;
  white-space: nowrap;
  box-sizing: border-box;
}

.active-filters-inner {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  gap: 12rpx;
  box-sizing: border-box;
}

.filter-bar-label {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 600;
  flex-shrink: 0;
}

.active-filter-chip {
  display: inline-flex;
  align-items: center;
  background: #eff6ff;
  border: 1rpx solid #bfdbfe;
  border-radius: 999rpx;
  padding: 4rpx 14rpx 4rpx 18rpx;
  gap: 8rpx;
  flex-shrink: 0;
}

.chip-label {
  font-size: 22rpx;
  color: #0263e0;
  font-weight: 600;
}

.chip-x {
  font-size: 20rpx;
  color: #3b82f6;
  font-weight: 700;
}

.clear-all-filter-btn {
  font-size: 22rpx;
  color: #94a3b8;
  font-weight: 500;
  padding: 4rpx 14rpx;
  flex-shrink: 0;
}

/* 4. 主体左右分栏布局 */
.cat-body-main {
  flex: 1;
  display: flex;
  overflow: hidden;
  background: #ffffff;
  width: 100%;
}

/* 左侧纵向分类导航 */
.cat-sidebar-wrapper {
  width: 156rpx;
  height: 100%;
  background: #f8fafd;
  border-right: 1rpx solid #eef2f6;
  flex-shrink: 0;
}

.cat-sidebar-scroll {
  height: 100%;
}

.sidebar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 26rpx 6rpx 24rpx;
  position: relative;
  border-bottom: 1rpx solid #f8fafc;
  box-sizing: border-box;
  width: 100%;
  transition: background-color 0.2s ease;
}

.sidebar-item-active {
  background: #ffffff !important;
}

.active-indicator-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: #0263e0;
}

.sidebar-icon-wrap {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sidebar-svg-icon {
  width: 40rpx;
  height: 40rpx;
}

.hot-badge {
  position: absolute;
  top: -10rpx;
  right: -28rpx;
  background: #ea580c;
  color: #ffffff;
  font-size: 16rpx;
  font-weight: 800;
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  transform: scale(0.85);
  line-height: 1.2;
}

.sidebar-label {
  font-size: 23rpx;
  color: #64748b;
  font-weight: 500;
  text-align: center;
  white-space: nowrap;
  line-height: 1.2;
}

.sidebar-item-active .sidebar-label {
  color: #0263e0 !important;
  font-weight: 800 !important;
}

/* 右侧内容主列表 */
.cat-content-wrapper {
  flex: 1;
  min-width: 0;
  height: 100%;
  background: #ffffff;
}

.cat-content-scroll {
  height: 100%;
  padding: 18rpx 20rpx 40rpx;
  box-sizing: border-box;
}

/* 细分场景卡片 */
.sub-scene-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 18rpx 18rpx 16rpx;
  border: 1.5rpx solid #eef2f6;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.02);
}

.scene-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.scene-header-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.scene-blue-bar {
  width: 6rpx;
  height: 24rpx;
  background: #0263e0;
  border-radius: 4rpx;
}

.scene-title-text {
  font-size: 26rpx;
  font-weight: 800;
  color: #0f172a;
}

.all-tags-text {
  font-size: 23rpx;
  color: #0263e0;
  font-weight: 600;
}

.scene-tags-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.scene-cell-item {
  background: #f1f5f9;
  border-radius: 14rpx;
  padding: 10rpx 4rpx;
  min-height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1.5rpx solid transparent;
  transition: all 0.15s ease;
  box-sizing: border-box;
}

.scene-cell-active {
  background: #e0eaff !important;
  border-color: #bfdbfe !important;
}

.scene-cell-name {
  font-size: 21rpx;
  color: #334155;
  font-weight: 500;
  white-space: nowrap;
  text-align: center;
  line-height: 1.25;
}

.scene-cell-active .scene-cell-name {
  color: #0263e0 !important;
  font-weight: 800 !important;
}

/* 1. 分类主标题、排序与筛选统一导航条 */
.cat-header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 2rpx 14rpx;
  width: 100%;
  box-sizing: border-box;
}

.cat-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.cat-current-name {
  font-size: 29rpx;
  font-weight: 800;
  color: #0f172a;
  white-space: nowrap;
}

.cat-count-badge {
  font-size: 20rpx;
  color: #64748b;
  background: #f1f5f9;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 600;
  white-space: nowrap;
}

.cat-actions-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.cat-sort-group {
  display: flex;
  align-items: center;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 2rpx;
}

.cat-sort-item {
  font-size: 21rpx;
  color: #64748b;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  font-weight: 500;
  transition: all 0.15s ease;
}

.cat-sort-item.sort-item-active {
  background: #ffffff;
  color: #0263e0;
  font-weight: 800;
  box-shadow: 0 2rpx 6rpx rgba(15, 23, 42, 0.08);
}

.cat-filter-icon-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: #eff6ff;
  border: 1rpx solid #bfdbfe;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  position: relative;
  transition: all 0.15s ease;
}

.cat-filter-icon-btn.filter-active {
  background: #0263e0;
  border-color: #0263e0;
}

.cat-filter-icon-btn.filter-active .filter-mini-icon {
  filter: brightness(0) invert(1);
}

.cat-filter-icon-btn.filter-active .filter-mini-text {
  color: #ffffff;
}

.filter-mini-icon {
  width: 20rpx;
  height: 20rpx;
}

.filter-mini-text {
  font-size: 20rpx;
  color: #0263e0;
  font-weight: 700;
}

.filter-dot-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: #ea580c;
  color: #ffffff;
  font-size: 16rpx;
  font-weight: 800;
  width: 26rpx;
  height: 26rpx;
  line-height: 26rpx;
  text-align: center;
  border-radius: 50%;
  border: 1.5rpx solid #ffffff;
  box-shadow: 0 2rpx 4rpx rgba(234, 88, 12, 0.3);
}

/* 2. 快捷细分标签横滑栏 (轻量高质感滑块，高度仅 48rpx) */
.quick-subtags-bar {
  margin: 0 0 16rpx 0;
  width: 100%;
}

.quick-subtags-scroll {
  width: 100%;
  white-space: nowrap;
}

.quick-subtags-track {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 2rpx 8rpx;
  box-sizing: border-box;
}

.quick-subtag-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 500;
  color: #475569;
  background: #f8fafc;
  padding: 0 22rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 24rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  transition: all 0.15s ease;
  border: 1rpx solid #e2e8f0;
  box-sizing: border-box;
}

.quick-subtag-pill.pill-active {
  background: #0263e0 !important;
  color: #ffffff !important;
  border-color: #0263e0 !important;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(2, 99, 224, 0.22);
}

/* 3. 资源卡片列表 */
.cat-resource-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.res-card-box {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 18rpx 16rpx;
  border: 1rpx solid #eef2f6;
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.02);
  transition: transform 0.15s ease;
}

.res-card-left {
  width: 82rpx;
  height: 82rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid #f1f5f9;
}

.res-card-icon {
  width: 44rpx;
  height: 44rpx;
}

.res-card-center {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.res-card-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  width: 100%;
}

.res-card-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #0f172a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
  line-height: 1.3;
}

.res-visual-badge {
  font-size: 19rpx;
  font-weight: 700;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  background: linear-gradient(135deg, #fff7ed, #ffedd5);
  color: #c2410c;
  border: 1rpx solid #fed7aa;
  flex-shrink: 0;
  line-height: 1.2;
}

.res-card-mid-row {
  min-height: 30rpx;
  display: flex;
  align-items: center;
}

.feed-tags-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: nowrap;
  overflow: hidden;
}

.feed-tag-pill {
  font-size: 19rpx;
  font-weight: 500;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  white-space: nowrap;
  line-height: 1.3;
}

.res-card-desc {
  font-size: 21rpx;
  color: #64748b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.3;
}

.res-card-meta-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  line-height: 1.2;
}

.meta-spec-text {
  color: #64748b;
  font-size: 20rpx;
  font-weight: 500;
}

.meta-spec-dot {
  color: #cbd5e1;
  font-size: 18rpx;
}

.meta-star-text {
  color: #d97706;
  font-size: 20rpx;
  font-weight: 700;
}

.res-card-right {
  flex-shrink: 0;
  margin-left: 2rpx;
}

.res-get-btn {
  background: #eff6ff;
  color: #0263e0;
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid #bfdbfe;
  line-height: 1.3;
  text-align: center;
  transition: all 0.15s ease;
}

/* 底部说明与求资源快捷通道 */
.cat-footer-wrap {
  text-align: center;
  padding: 32rpx 0 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.footer-hint-text {
  font-size: 21rpx;
  color: #94a3b8;
}

.footer-request-link {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #0263e0;
  font-weight: 600;
  padding: 4rpx 12rpx;
}

.rect-icon {
  font-size: 22rpx;
  line-height: 1;
}

/* 5. 半屏多维高级筛选抽屉 (Bottom Sheet，彻底规避顶部胶囊遮挡) */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.48);
  backdrop-filter: blur(4rpx);
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.28s ease;
}

.drawer-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.drawer-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 78vh;
  min-height: 55vh;
  background: #ffffff;
  border-radius: 36rpx 36rpx 0 0;
  z-index: 1001;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8rpx 32rpx rgba(15, 23, 42, 0.12);
  box-sizing: border-box;
  overflow: hidden;
}

.drawer-panel.show {
  transform: translateY(0);
}

.drawer-handle-bar {
  width: 72rpx;
  height: 8rpx;
  background: #cbd5e1;
  border-radius: 999rpx;
  margin: 16rpx auto 8rpx;
  flex-shrink: 0;
}

.drawer-header {
  padding: 16rpx 28rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f1f5f9;
  flex-shrink: 0;
}

.drawer-title-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.drawer-filter-icon {
  width: 36rpx;
  height: 36rpx;
}

.drawer-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
}

.drawer-badge-tag {
  font-size: 20rpx;
  font-weight: 700;
  color: #0263e0;
  background: #eff6ff;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  line-height: 1.3;
}

.drawer-close-box {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.drawer-close-x {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 700;
  line-height: 1;
}

.drawer-body {
  flex: 1;
  padding: 24rpx 28rpx 20rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.filter-section {
  margin-bottom: 32rpx;
}

.filter-section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.filter-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
  margin-bottom: 0;
}

.filter-tip {
  font-size: 20rpx;
  color: #94a3b8;
  font-weight: 500;
}

.filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  padding: 14rpx 24rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #475569;
  background: #f8fafc;
  border: 1.5rpx solid #e2e8f0;
  transition: all 0.15s ease;
  line-height: 1.2;
}

.chip.active {
  background: #eff6ff !important;
  border-color: #3b82f6 !important;
  color: #0263e0 !important;
  font-weight: 700 !important;
}

.drawer-footer {
  padding: 20rpx 28rpx;
  display: flex;
  gap: 20rpx;
  border-top: 1rpx solid #f1f5f9;
  background: #ffffff;
  flex-shrink: 0;
}

.drawer-reset-btn {
  flex: 1;
  background: #f1f5f9;
  color: #475569;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  height: 84rpx;
  line-height: 84rpx;
  border: none;
  margin: 0 !important;
  padding: 0 !important;
}

.drawer-confirm-btn {
  flex: 2;
  background: linear-gradient(135deg, #0263e0 0%, #0850c4 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  border-radius: 999rpx;
  height: 84rpx;
  line-height: 84rpx;
  border: none;
  box-shadow: 0 4rpx 14rpx rgba(2, 99, 224, 0.28);
  margin: 0 !important;
  padding: 0 !important;
}

/* 4. 已生效的高级筛选芯片行 */
.active-filter-chips-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
  padding: 4rpx 2rpx 12rpx;
}

.filter-summary-label {
  font-size: 21rpx;
  color: #64748b;
  font-weight: 600;
}

.active-summary-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 21rpx;
  background: #eff6ff;
  color: #0263e0;
  border: 1rpx solid #bfdbfe;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.chip-x {
  font-size: 20rpx;
  font-weight: 800;
}

.clear-all-link {
  font-size: 21rpx;
  color: #ef4444;
  margin-left: 6rpx;
}


