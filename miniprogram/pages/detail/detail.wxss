/* pages/detail/detail.wxss */
.detail-container {
  padding: 24rpx;
  background-color: #f8f9ff;
  min-height: 100vh;
}

/* 主卡片 */
.hero-card {
  background: #ffffff;
  border-radius: 24rpx;
  border: 1rpx solid #e2e8f0;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.03);
}

.hero-top {
  display: flex;
  margin-bottom: 24rpx;
}

.hero-icon {
  font-size: 72rpx;
  margin-right: 20rpx;
}

.hero-header-text {
  flex: 1;
}

.hero-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.hero-version-pill {
  display: inline-block;
  background: #eff6ff;
  color: #3B82F6;
  font-size: 24rpx;
  font-weight: bold;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 10rpx;
}

.safe-badge {
  font-size: 24rpx;
  color: #16a34a;
}

/* 四格数据 */
.meta-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-top: 1rpx solid #f1f5f9;
  padding-top: 20rpx;
  text-align: center;
}

.meta-cell {
  display: flex;
  flex-direction: column;
}

.meta-val {
  font-size: 28rpx;
  font-weight: bold;
  color: #1e293b;
  margin-bottom: 4rpx;
}

.meta-lbl {
  font-size: 24rpx;
  color: #94a3b8;
}

/* 直链提示 */
.ready-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #eff6ff;
  border: 1rpx solid #bfdbfe;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
}

.ready-left {
  display: flex;
  align-items: center;
}

.ready-dot {
  width: 12rpx;
  height: 12rpx;
  background: #10b981;
  border-radius: 50%;
  margin-right: 12rpx;
}

.ready-text {
  font-size: 26rpx;
  color: #1e40af;
  font-weight: 500;
}

.ready-btn {
  font-size: 24rpx;
  color: #3B82F6;
  font-weight: bold;
}

/* 选项卡 */
.detail-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  border: 1rpx solid #e2e8f0;
  margin-bottom: 20rpx;
}

.tab-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: #64748b;
  border-radius: 12rpx;
}

.tab-btn.active {
  background: #3B82F6;
  color: #ffffff;
  font-weight: bold;
}

/* 正文卡片 */
.content-card {
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #e2e8f0;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.feature-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.mt-16 {
  margin-top: 24rpx;
}

.feature-p {
  font-size: 26rpx;
  color: #475569;
  line-height: 1.6;
  margin-bottom: 10rpx;
}

.screenshot-tip {
  font-size: 26rpx;
  color: #94a3b8;
  background: #f8fafc;
  padding: 20rpx;
  border-radius: 12rpx;
  text-align: center;
}

/* 免责声明 */
.disclaimer-card {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.disclaimer-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #64748b;
  margin-bottom: 6rpx;
}

.disclaimer-text {
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.5;
}

.bottom-placeholder {
  height: 120rpx;
}

/* 底部操作栏 */
.action-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-top: 1rpx solid #e2e8f0;
  padding: 16rpx 24rpx 36rpx;
  display: flex;
  align-items: center;
  z-index: 50;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
  background: transparent;
  padding: 0;
  line-height: 1;
}

.share-btn::after {
  border: none;
}

.action-icon {
  font-size: 32rpx;
  margin-bottom: 6rpx;
}

.action-lbl {
  font-size: 22rpx;
  color: #64748b;
}

.get-resource-btn {
  flex: 1;
  background: #3B82F6;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
}

/* 弹层 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.modal-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.modal-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s;
}

.modal-sheet.show {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 30rpx 20rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #0f172a;
}

.modal-close {
  font-size: 36rpx;
  color: #94a3b8;
}

.modal-body {
  padding: 30rpx;
}

.node-status {
  display: flex;
  align-items: center;
  background: #f0fdf4;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  background: #16a34a;
  border-radius: 50%;
  margin-right: 12rpx;
}

.status-text {
  font-size: 24rpx;
  color: #15803d;
  font-weight: 500;
}

.link-box {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.link-label {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.link-url {
  font-size: 26rpx;
  color: #3B82F6;
  word-break: break-all;
}

.pwd-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 30rpx;
}

.pwd-left {
  display: flex;
  align-items: center;
}

.pwd-label {
  font-size: 26rpx;
  color: #64748b;
}

.pwd-val {
  font-size: 30rpx;
  font-weight: bold;
  color: #3B82F6;
  margin-left: 12rpx;
}

.pwd-copy-btn {
  background: #eff6ff;
  color: #3B82F6;
  font-size: 24rpx;
  font-weight: bold;
  padding: 6rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid #bfdbfe;
  margin: 0;
  line-height: 1.6;
}

.copy-all-btn {
  background: #3B82F6;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  margin-bottom: 20rpx;
}

.modal-tip {
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
}
