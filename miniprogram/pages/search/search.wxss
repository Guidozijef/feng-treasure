/* 搜索中心页面整体样式 (1:1 像素级还原) */
page {
  background-color: #f8fafd;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  box-sizing: border-box;
  width: 100%;
  overflow-x: hidden;
}

.search-page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 100%;
  overflow-x: hidden;
}

/* 1. 顶部搜索栏 */
.search-top-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #ffffff;
  padding: 16rpx 28rpx 20rpx;
  width: 100%;
  box-sizing: border-box;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.02);
}

.search-capsule-box {
  flex: 1;
  background: #f1f5f9;
  border-radius: 999rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 14rpx;
  box-sizing: border-box;
}

.search-glass-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  opacity: 0.7;
}

.search-text-input {
  flex: 1;
  font-size: 28rpx;
  color: #0f172a;
  font-weight: 600;
  height: 100%;
}

.search-input-placeholder {
  color: #94a3b8;
  font-size: 26rpx;
  font-weight: 400;
}

.clear-circle-btn {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #cbd5e1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.clear-cross {
  font-size: 18rpx;
  color: #ffffff;
  line-height: 1;
  font-weight: 700;
}

.search-action-btn {
  font-size: 30rpx;
  color: #0263e0;
  font-weight: 700;
  padding: 8rpx 8rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

/* 2. 排序筛选栏与资源计数 */
.filter-bar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx 14rpx;
  width: 100%;
  box-sizing: border-box;
}

.sort-tabs-group {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.sort-pill-item {
  font-size: 24rpx;
  font-weight: 600;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  color: #475569;
  background: #ffffff;
  border: 1.5rpx solid #e2e8f0;
  transition: all 0.2s ease;
  line-height: 1.2;
}

.sort-pill-active {
  background: #0263e0 !important;
  color: #ffffff !important;
  border-color: #0263e0 !important;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(2, 99, 224, 0.25);
}

.result-count-label {
  font-size: 23rpx;
  color: #64748b;
  white-space: nowrap;
}

.highlight-count {
  color: #0263e0;
  font-weight: 800;
}

/* 3. 资源列表容器 */
.resource-list-container {
  padding: 12rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 资源卡片 */
.resource-card-item {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 22rpx 22rpx;
  border: 1.5rpx solid #eef2f6;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.02);
  width: 100%;
  box-sizing: border-box;
}

/* 左侧图标盒子 */
.res-icon-box {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.res-svg-img {
  width: 52rpx;
  height: 52rpx;
}

/* 中间内容区 */
.res-info-center {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.res-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: nowrap;
}

.res-title-text {
  font-size: 29rpx;
  font-weight: 800;
  color: #0f172a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 350rpx;
}

.res-version-badge {
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  line-height: 1.3;
  flex-shrink: 0;
}

.ver-blue {
  background: #eff6ff;
  color: #2563eb;
}

.ver-green {
  background: #ecfdf5;
  color: #059669;
}

.ver-yellow {
  background: #fefce8;
  color: #ca8a04;
}

/* 特色标签组 */
.res-tags-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.res-tag-pill {
  font-size: 21rpx;
  font-weight: 600;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  line-height: 1.35;
}

.tag-blue {
  background: #eff6ff;
  color: #2563eb;
}

.tag-green {
  background: #ecfdf5;
  color: #059669;
}

.tag-yellow {
  background: #fefce8;
  color: #ca8a04;
}

.tag-orange {
  background: #fefce8;
  color: #ffd930;
}

.tag-slate {
  background: #f1f5f9;
  color: #475569;
}

/* 元信息行 */
.res-meta-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  overflow: hidden;
  white-space: nowrap;
}

.star-rating {
  font-weight: 700;
  color: #d97706;
  flex-shrink: 0;
}

.meta-dot {
  color: #cbd5e1;
  flex-shrink: 0;
}

.meta-text {
  color: #64748b;
  font-size: 22rpx;
  flex-shrink: 0;
}

.meta-channel-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 220rpx;
}

/* 右侧操作按钮 */
.res-action-right {
  flex-shrink: 0;
}

.res-btn-solid {
  background: #0263e0;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  border-radius: 999rpx;
  width: 120rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(2, 99, 224, 0.28);
}

.res-btn-outline {
  background: #eff6ff;
  color: #2563eb;
  font-size: 26rpx;
  font-weight: 800;
  border-radius: 999rpx;
  width: 120rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1.5rpx solid #bfdbfe;
  box-sizing: border-box;
}

/* 空状态 */
.empty-search-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-search-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.empty-main-text {
  font-size: 29rpx;
  font-weight: 800;
  color: #334155;
  margin-bottom: 12rpx;
}

.empty-sub-tip {
  font-size: 23rpx;
  color: #94a3b8;
  line-height: 1.5;
  margin-bottom: 32rpx;
}

.empty-jump-btn {
  background: #0263e0;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 14rpx rgba(2, 99, 224, 0.25);
}

/* 4. 底部虚线求资源卡片 */
.bottom-wish-banner {
  margin: 24rpx 28rpx 16rpx;
  background: #f5f8ff;
  border: 2rpx dashed #dbeafe;
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
  width: auto;
}

.wish-banner-left {
  flex-shrink: 0;
}

.wish-robot-circle {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: #e0eaff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bot-helper-icon {
  width: 38rpx;
  height: 38rpx;
}

.wish-banner-center {
  flex: 1;
  min-width: 0;
}

.wish-main-q {
  font-size: 27rpx;
  font-weight: 800;
  color: #0f172a;
}

.wish-sub-tip {
  font-size: 21rpx;
  color: #64748b;
  margin-top: 4rpx;
  line-height: 1.35;
}

.wish-banner-right {
  flex-shrink: 0;
}

.wish-btn-link {
  font-size: 27rpx;
  font-weight: 800;
  color: #0263e0;
}

/* 5. 底部版权说明 */
.page-bottom-footer {
  text-align: center;
  padding: 36rpx 0 60rpx;
  width: 100%;
}

.footer-text {
  font-size: 22rpx;
  color: #94a3b8;
  letter-spacing: 0.5rpx;
}
