/** 全局微信小程序基础样式 **/
page {
  background-color: #f8f9ff;
  color: #1e293b;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

view, text, image, navigator, input, button {
  box-sizing: border-box;
}

/* 主题颜色变量定义 */
.text-primary { color: #3B82F6; }
.bg-primary { background-color: #3B82F6; color: #ffffff; }
.text-secondary { color: #475569; }
.text-muted { color: #94a3b8; }
.bg-surface { background-color: #ffffff; }

/* 常用卡片与布局通用类 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #e2e8f0;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.line-clamp-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 按钮与卡片点击触感反馈 */
.btn-hover {
  opacity: 0.85;
  transform: scale(0.98);
}

.card-hover {
  opacity: 0.92;
  transform: scale(0.99);
}

/* 全局统一产品细分标签样式 (列表、详情、分类三端 100% 对齐) */
.feed-tags-row, .detail-tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  align-items: center;
}

.feed-tags-row {
  margin-bottom: 8rpx;
}

.detail-tags-row {
  margin-top: 10rpx;
  margin-bottom: 12rpx;
}

.feed-tag-pill {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 500;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  line-height: 1.3;
}

.tag-blue { background: #eff6ff; color: #2563eb; border: 1rpx solid #dbeafe; }
.tag-green { background: #f0fdf4; color: #16a34a; border: 1rpx solid #dcfce7; }
.tag-orange { background: #fff7ed; color: #d97706; border: 1rpx solid #ffedd5; }
.tag-purple { background: #f5f3ff; color: #7c3aed; border: 1rpx solid #ede9fe; }
.tag-red { background: #fef2f2; color: #ef4444; border: 1rpx solid #fee2e2; }

